[Unit]
Description=VLC PROACTIVA API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=vpro
Group=vpro
EnvironmentFile=/etc/vpro/env
Environment=PYTHONPATH=/opt/vpro/src/backend
WorkingDirectory=/opt/vpro
ExecStart=/opt/vpro/.venv/bin/uvicorn src.backend.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
